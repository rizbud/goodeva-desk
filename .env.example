# Application
NODE_ENV=development
PORT=3000

# PostgreSQL Database (Prisma)
DATABASE_URL=postgresql://goodeva:goodeva@localhost:5432/goodeva_db

# Redis (BullMQ & Cache)
REDIS_URL=redis://localhost:6379

# LLM Configuration (Google Gemini via OpenAI-compatible endpoint)
LLM_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_API_KEY=your_gemini_api_key_here
LLM_MODEL_ID=gemini-2.5-flash-lite

# Rate Limiting (per IP and per Organization API Key)
THROTTLE_IP_TTL=60
THROTTLE_IP_LIMIT=60
THROTTLE_ORG_TTL=60
THROTTLE_ORG_LIMIT=120